    "devflow",
    "debugging"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ansh-n-chovatiya/DevFlow.git",
    "directory": "mcp-server"
  },
  "homepage": "https://github.com/ansh-n-chovatiya/DevFlow#readme",
  "bugs": {
    "url": "https://github.com/ansh-n-chovatiya/DevFlow/issues"
  },
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
