    "rsc.js",
    "README.md",
    "regression.js",
    "regression-cli.js"
  ],
  "license": "MIT",
  "author": "Ansh Chovatiya",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "claude",
    "claude-code",
